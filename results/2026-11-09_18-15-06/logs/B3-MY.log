[t=  3.66s] A | => 1 row(s) affected
[t=  3.66s]     B | UPDATE inventory SET qty_reserved = qty_reserved + 1, version = version + 1 WHERE variant_id = 101 AND location_id = 3 AND version = 0 AND (qty_on_hand - qty_reserved) >= 1 (đang chờ...)
[t=  4.67s] A | COMMIT
