# Chỉ dùng khi chạy KHÔNG qua Docker (Linux / macOS, MySQL và MongoDB cài trên máy).
# Sao chép thành env.sh, sửa đường dẫn cho đúng máy, rồi:  source env.sh && python run.py
export MYSQL_HOST=127.0.0.1
export MYSQL_USER=demo
export MYSQL_PASSWORD=demo123
# Client quản trị (root) dùng để nạp lại schema và đổi biến GLOBAL
export MYSQL_CLI="mysql --defaults-file=$HOME/srv/my.cnf"
export MYSQL_ERROR_LOG="$HOME/srv/mysql-error.log"
# C1: kill -9 rồi khởi động lại mysqld
export MYSQL_KILL_CMD="kill -9 \$(cat $HOME/srv/mysqld.pid)"
export MYSQL_START_CMD="nohup mysqld --defaults-file=$HOME/srv/my.cnf >> $HOME/srv/mysqld.out 2>&1 &"
# MongoDB replica set dựng bằng setup/start_mongo_replset.sh
export MONGOD_BIN=mongod
export MONGO_DATA="$(pwd)/data"
